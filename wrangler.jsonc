// Cloudflare Workers: serves the static site straight from public/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-in-bio",
  "compatibility_date": "2026-11-01",
  // Required by the Cloudflare Builds preview pipeline (`npx wrangler preview`)
  "previews": {},
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
